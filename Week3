# =========================================================
# MAIN APP
# =========================================================

class App(tk.Tk):

    def __init__(self):

        super().__init__()

        self.title("iHANDA Dagupan")
        self.geometry("900x650")
        self.minsize(700, 500)

        self.current_frame = None

        # Main container
        container = tk.Frame(
            self,
            bg=BACKGROUND
        )

        container.pack(
            fill="both",
            expand=True
        )

        container.grid_rowconfigure(
            0,
            weight=1
        )

        container.grid_columnconfigure(
            0,
            weight=1
        )

        self.container = container

        self.frames = {}

        # Create screens
        for Page in (
            HomeScreen,
            DisasterScreen,
            ReadyKitScreen,
            EmergencyReportScreen,
            EmergencyResponseScreen
        ):

            frame = Page(
                container,
                self
            )

            self.frames[
                Page.__name__
            ] = frame

            frame.grid(
                row=0,
                column=0,
                sticky="nsew"
            )

        # Global mouse wheel
        self.bind_all(
            "<MouseWheel>",
            self.global_mouse_scroll
        )

        self.show_frame(
            "HomeScreen"
        )


    # =====================================================
    # SHOW SCREEN
    # =====================================================

    def show_frame(self, page_name):

        frame = self.frames[page_name]

        self.current_frame = frame

        frame.tkraise()

        if hasattr(
            frame,
            "reset_scroll"
        ):

            frame.reset_scroll()


    # =====================================================
    # GLOBAL MOUSE SCROLL
    # =====================================================

    def global_mouse_scroll(self, event):

        if self.current_frame is not None:

            if hasattr(
                self.current_frame,
                "mouse_scroll"
            ):

                self.current_frame.mouse_scroll(
                    event
                )


# =========================================================
# HEADER / NAVIGATION
# =========================================================

def create_navigation(
    parent,
    controller,
    active_page
):

    header = tk.Canvas(
        parent,
        height=110,
        bg=BLUE,
        highlightthickness=0
    )

    header.pack(
        fill="x"
    )


    # -----------------------------------------------------
    # BRAND
    # -----------------------------------------------------

    brand = tk.Frame(
        header,
        bg=BLUE
    )

    header.create_window(
        25,
        20,
        window=brand,
        anchor="nw"
    )


    tk.Label(
        brand,
        text="iHANDA Dagupan",
        font=("Arial", 24, "bold"),
        bg=BLUE,
        fg=WHITE
    ).pack(
        anchor="w"
    )


    tk.Label(
        brand,
        text="Disaster Preparedness System",
        font=("Arial", 10),
        bg=BLUE,
        fg=WHITE
    ).pack(
        anchor="w",
        pady=(2, 0)
    )


    # -----------------------------------------------------
    # NAVIGATION FRAME
    # -----------------------------------------------------

    nav_frame = tk.Frame(
        header,
        bg=RED
    )


    buttons = [
        (
            "Home",
            "HomeScreen"
        ),
        (
            "Disaster Recognition",
            "DisasterScreen"
        ),
        (
            "Ready Kit",
            "ReadyKitScreen"
        ),
        (
            "Emergency Report",
            "EmergencyReportScreen"
        ),
        (
            "Emergency Responses",
            "EmergencyResponseScreen"
        )
    ]


    for text, page in buttons:

        if page == active_page:

            bg_color = WHITE
            fg_color = RED

        else:

            bg_color = RED
            fg_color = WHITE


        button = tk.Button(
            nav_frame,
            text=text,
            font=("Arial", 8, "bold"),
            bg=bg_color,
            fg=fg_color,
            activebackground=WHITE,
            activeforeground=RED,
            relief="flat",
            bd=0,
            padx=6,
            pady=7,
            cursor="hand2",
            command=lambda p=page:
                controller.show_frame(p)
        )

        button.pack(
            side="left",
            padx=1
        )


    nav_window = header.create_window(
        0,
        55,
        window=nav_frame,
        anchor="e"
    )


    # -----------------------------------------------------
    # DRAW MERGED BLUE + RED HEADER
    # -----------------------------------------------------

    def resize_header(event):

        width = event.width
        height = 110

        header.delete(
            "background"
        )

        # Blue base
        header.create_rectangle(
            0,
            0,
            width,
            height,
            fill=BLUE,
            outline="",
            tags="background"
        )

        # Red merged section
        red_start = max(
            width * 0.57,
            width - 600
        )

        header.create_polygon(
            red_start + 45,
            0,
            width,
            0,
            width,
            height,
            red_start - 45,
            height,
            fill=RED,
            outline="",
            tags="background"
        )

        header.tag_lower(
            "background"
        )

        header.coords(
            nav_window,
            width - 18,
            55
        )


    header.bind(
        "<Configure>",
        resize_header
    )

    return header


