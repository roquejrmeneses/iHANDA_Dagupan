                photo_name = report["photo"].split("/")[-1]

                tk.Label(
                    report_box,
                    text="Photo: " + photo_name,
                    font=("Arial", 9, "italic"),
                    bg=WHITE,
                    fg=GRAY,
                    anchor="w"
                ).pack(
                    anchor="w",
                    pady=(10, 0)
                )

            else:

                tk.Label(
                    report_box,
                    text="Photo: No photo attached",
                    font=("Arial", 9, "italic"),
                    bg=WHITE,
                    fg=GRAY,
                    anchor="w"
                ).pack(
                    anchor="w",
                    pady=(10, 0)
                )


    # =====================================================
    # SCROLL FUNCTIONS
    # =====================================================

    def update_scroll(self, event=None):

        self.canvas.configure(
            scrollregion=self.canvas.bbox("all")
        )


    def resize_content(self, event):

        self.canvas.itemconfig(
            self.canvas_window,
            width=event.width
        )


    def mouse_scroll(self, event):

        self.canvas.yview_scroll(
            int(
                -1 * (event.delta / 120)
            ),
            "units"
        )


    def reset_scroll(self):

        self.canvas.yview_moveto(
            0
        )

        self.display_reports()


