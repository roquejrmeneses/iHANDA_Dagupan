    # =====================================================
    # VALIDATE NAME
    # =====================================================

    def validate_letters(self, value):

        if value == "":
            return True

        for character in value:

            if not (
                character.isalpha()
                or character == " "
            ):

                return False

        return True


    # =====================================================
    # VALIDATE CONTACT NUMBER
    # =====================================================

    def validate_numbers(self, value):

        if value == "":
            return True

        return value.isdigit()


    # =====================================================
    # BARANGAY SEARCH
    # =====================================================

    def search_barangay(self, event=None):

        search_text = (
            self.location_search
            .get()
            .lower()
            .strip()
        )


        if (
            search_text == ""
            or
            search_text == "type to search barangay..."
        ):

            self.barangay_menu["values"] = (
                self.barangays
            )

            return


        filtered_barangays = []


        for barangay in self.barangays:

            if search_text in barangay.lower():

                filtered_barangays.append(
                    barangay
                )


        self.barangay_menu["values"] = (
            filtered_barangays
        )


    # =====================================================
    # SEARCH FOCUS IN
    # =====================================================

    def search_focus_in(self, event):

        if self.location_search.get() == "Type to search barangay...":

            self.location_search.delete(
                0,
                "end"
            )

            self.location_search.config(
                fg=TEXT
            )


    # =====================================================
    # SEARCH FOCUS OUT
    # =====================================================

    def search_focus_out(self, event):

        if self.location_search.get().strip() == "":

            self.location_search.insert(
                0,
                "Type to search barangay..."
            )

            self.location_search.config(
                fg=GRAY
            )


            self.barangay_menu["values"] = (
                self.barangays
            )


    # =====================================================
    # IMPORT PHOTO
    # =====================================================

    def import_photo(self):

        file_path = filedialog.askopenfilename(

            title="Select Emergency Photo",

            filetypes=[
                (
                    "Image Files",
                    "*.jpg *.jpeg *.png *.gif"
                ),
                (
                    "JPG Files",
                    "*.jpg *.jpeg"
                ),
                (
                    "PNG Files",
                    "*.png"
                ),
                (
                    "GIF Files",
                    "*.gif"
                )
            ]
        )


        if file_path != "":

            self.photo_path = file_path

            file_name = file_path.split("/")[-1]

            self.photo_label.config(
                text=file_name,
                fg=TEXT
            )


    # =====================================================
    # SCROLL FUNCTIONS
    # =====================================================

    def update_scroll(self, event=None):

        self.canvas.configure(
            scrollregion=self.canvas.bbox("all")
        )


    def resize_content(self, event):

        self.canvas.itemconfig(
            self.canvas_window,
            width=event.width
        )


    def mouse_scroll(self, event):

        self.canvas.yview_scroll(
            int(
                -1 * (event.delta / 120)
            ),
            "units"
        )


    def reset_scroll(self):

        self.canvas.yview_moveto(
            0
        )


    # =====================================================
    # SUBMIT REPORT
    # =====================================================

    def submit_report(self):

        name = self.name_entry.get().strip()

        contact = self.contact_entry.get().strip()

        barangay = self.barangay_menu.get()

        location = self.location_entry.get().strip()

        emergency = self.emergency_type.get()

        description = self.description_text.get(
            "1.0",
            "end"
        ).strip()


        # -------------------------------------------------
        # VALIDATION
        # -------------------------------------------------

        if name == "":

            messagebox.showwarning(
                "Missing Information",
                "Please enter your name."
            )

            return


        if contact == "":

            messagebox.showwarning(
                "Missing Information",
                "Please enter your contact number."
            )

            return


        if barangay == "" or barangay == "Select Barangay / Area":

            messagebox.showwarning(
                "Missing Information",
                "Please select your Barangay / Area."
            )

            return


        if location == "":

            messagebox.showwarning(
                "Missing Information",
                "Please enter the exact location or landmark."
            )

            return


        if emergency == "Select Emergency Type":

            messagebox.showwarning(
                "Missing Information",
                "Please select the emergency type."
            )

            return


        if description == "":

            messagebox.showwarning(
                "Missing Information",
                "Please enter a description."
            )

            return


        # -------------------------------------------------
        # GET DATE AND TIME
        # -------------------------------------------------

        report_datetime = datetime.now().strftime(
            "%B %d, %Y | %I:%M %p"
        )


        # -------------------------------------------------
        # SAVE REPORT TO ARRAY
        # -------------------------------------------------

        report = {
            "name": name,
            "contact": contact,
            "barangay": barangay,
            "location": location,
            "emergency": emergency,
            "description": description,
            "photo": self.photo_path,
            "date_time": report_datetime
        }


        EMERGENCY_REPORTS.append(
            report
        )


        # -------------------------------------------------
        # SUCCESS
        # -------------------------------------------------

        messagebox.showinfo(
            "Report Submitted",
            "Your emergency report has been submitted."
        )


        # -------------------------------------------------
        # CLEAR FORM
        # -------------------------------------------------

        self.name_entry.delete(
            0,
            "end"
        )


        self.contact_entry.delete(
            0,
            "end"
        )


        self.location_search.delete(
            0,
            "end"
        )


        self.location_search.insert(
            0,
            "Type to search barangay..."
        )


        self.location_search.config(
            fg=GRAY
        )


        self.barangay_menu["values"] = (
            self.barangays
        )


        self.barangay_menu.set(
            "Select Barangay / Area"
        )


        self.location_entry.delete(
            0,
            "end"
        )


        self.emergency_type.set(
            "Select Emergency Type"
        )


        self.description_text.delete(
            "1.0",
            "end"
        )


        self.photo_path = ""


        self.photo_label.config(
            text="No photo selected",
            fg=GRAY
        )


