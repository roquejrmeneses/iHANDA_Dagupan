# =========================
# DISASTER PAGE
# =========================

def show_disaster(name=None):

    clear()

    tk.Label(
        content,
        text="Disaster Safety Information",
        font=("Arial", 22, "bold"),
        bg=BACKGROUND,
        fg=BLUE
    ).pack(
        pady=(20, 10)
    )


    # =========================
    # DISASTER BUTTONS
    # =========================

    buttons = tk.Frame(
        content,
        bg=BACKGROUND
    )

    buttons.pack(
        pady=5
    )


    for disaster in disasters:

        tk.Button(
            buttons,
            text=disaster,
            width=12,
            bg=RED if disaster in ["Flood", "Tsunami"]
            else "#2563A6",
            fg=WHITE,
            command=lambda d=disaster: show_disaster(d)
        ).pack(
            side="left",
            padx=4
        )


    # =========================
    # SCROLL AREA
    # =========================

    area = tk.Frame(
        content,
        bg=BACKGROUND
    )

    area.pack(
        fill="both",
        expand=True,
        padx=40,
        pady=10
    )


    canvas = tk.Canvas(
        area,
        bg=BACKGROUND,
        highlightthickness=0
    )


    scrollbar = tk.Scrollbar(
        area,
        orient="vertical",
        command=canvas.yview
    )


    info = tk.Frame(
        canvas,
        bg=WHITE
    )


    canvas_window = canvas.create_window(
        (0, 0),
        window=info,
        anchor="nw"
    )


    def update_scroll(event):

        canvas.configure(
            scrollregion=canvas.bbox("all")
        )


    info.bind(
        "<Configure>",
        update_scroll
    )


    def resize_info(event):

        canvas.itemconfig(
            canvas_window,
            width=event.width
        )


    canvas.bind(
        "<Configure>",
        resize_info
    )


    canvas.configure(
        yscrollcommand=scrollbar.set
    )


    canvas.pack(
        side="left",
        fill="both",
        expand=True
    )


    scrollbar.pack(
        side="right",
        fill="y"
    )


    # =========================
    # INFORMATION
    # =========================

    if name:

        tk.Label(
            info,
            text=name,
            font=("Arial", 20, "bold"),
            bg=WHITE,
            fg=RED
        ).pack(
            pady=(15, 8)
        )


        tk.Label(
            info,
            text="What is " + name + "?",
            font=("Arial", 15, "bold"),
            bg=WHITE,
            fg=BLUE
        ).pack(
            anchor="w",
            padx=25,
            pady=(5, 5)
        )


        tk.Label(
            info,
            text=disasters[name]["description"],
            font=("Arial", 11),
            bg=WHITE,
            fg=DARK_GRAY,
            wraplength=700,
            justify="left"
        ).pack(
            fill="x",
            padx=25,
            pady=(0, 15)
        )


        # =========================
        # BEFORE / DURING / AFTER
        # =========================

        for part in ["Before", "During", "After"]:

            tk.Label(
                info,
                text=part,
                font=("Arial", 15, "bold"),
                bg=WHITE,
                fg=BLUE
            ).pack(
                anchor="w",
                padx=25,
                pady=(10, 5)
            )


            for text in disasters[name][part]:

                tk.Label(
                    info,
                    text="• " + text,
                    font=("Arial", 11),
                    bg=WHITE,
                    fg=DARK_GRAY,
                    wraplength=700,
                    justify="left",
                    anchor="w"
                ).pack(
                    fill="x",
                    padx=30,
                    pady=4
                )


        tk.Label(
            info,
            text="Information based on official disaster preparedness guidance.",
            font=("Arial", 9, "italic"),
            bg=WHITE,
            fg="#777777"
        ).pack(
            pady=20
        )


    else:

        tk.Label(
            info,
            text="Select a disaster above to view its information.",
            font=("Arial", 12),
            bg=WHITE,
            fg=DARK_GRAY
        ).pack(
            pady=40
        )


    # =========================
    # MOUSE SCROLL
    # =========================

    def disaster_mouse_scroll(event):

        canvas.yview_scroll(
            int(-1 * (event.delta / 120)),
            "units"
        )


    canvas.bind_all(
        "<MouseWheel>",
        disaster_mouse_scroll
    )


# =========================
# MENU
# =========================

def show_menu():

    global menu_frame

    # Close menu if already open
    if menu_frame is not None:

        menu_frame.destroy()
        menu_frame = None

        return


    # =========================
    # MENU FRAME
    # =========================

    menu_frame = tk.Frame(
        window,
        bg=WHITE,
        bd=1,
        relief="solid"
    )


    menu_frame.place(
        relx=0.97,
        y=105,
        anchor="ne",
        width=280
    )


    tk.Label(
        menu_frame,
        text="Menu",
        font=("Arial", 15, "bold"),
        bg=WHITE,
        fg=BLUE
    ).pack(
        pady=(15, 8)
    )


    pages = [
        ("Home", show_home),
        ("Disaster Recognition", show_disaster),
        ("Safety Precautions / Ready Kit", show_ready_kit)
    ]


    def select_page(command):

        global menu_frame

        if menu_frame is not None:

            menu_frame.destroy()
            menu_frame = None

        command()


    for text, command in pages:

        button = tk.Button(
            menu_frame,
            text=text,
            font=("Arial", 10, "bold"),
            bg="#2563A6",
            fg=WHITE,
            activebackground="#2563A6",
            activeforeground=WHITE,
            relief="flat",
            cursor="hand2",
            command=lambda c=command: select_page(c)
        )

        button.pack(
            fill="x",
            padx=15,
            pady=4
        )


    tk.Button(
        menu_frame,
        text="Close",
        font=("Arial", 9, "bold"),
        bg=WHITE,
        fg=RED,
        relief="flat",
        cursor="hand2",
        command=close_menu
    ).pack(
        pady=8
    )


