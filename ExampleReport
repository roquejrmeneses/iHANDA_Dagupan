
import tkinter as tk
from tkinter import messagebox


# =========================
# MAIN WINDOW
# =========================

window = tk.Tk()

window.title("iHANDA Dagupan")

window.geometry("900x650")

window.resizable(False, False)

window.configure(
    bg="#F5F6FA"
)


# =========================
# HEADER
# =========================

header = tk.Frame(
    window,
    bg="#123B6D",
    height=120
)

header.pack(
    fill="x"
)


title = tk.Label(
    header,
    text="iHANDA Dagupan",
    font=("Arial", 30, "bold"),
    bg="#123B6D",
    fg="white"
)

title.place(
    x=40,
    y=25
)


subtitle = tk.Label(
    header,
    text="Disaster Preparedness System",
    font=("Arial", 12),
    bg="#123B6D",
    fg="#DCE6F2"
)

subtitle.place(
    x=43,
    y=70
)


# =========================
# CONTENT
# =========================

content = tk.Frame(
    window,
    bg="#F5F6FA"
)

content.pack(
    fill="both",
    expand=True
)


# =========================
# EMERGENCY REPORT
# =========================

def show_emergency_report():

    clear_content()


    # =========================
    # TITLE
    # =========================

    report_title = tk.Label(
        content,
        text="Emergency Report",
        font=("Arial", 22, "bold"),
        bg="#F5F6FA",
        fg="#C62828"
    )

    report_title.pack(
        pady=(25, 5)
    )


    report_subtitle = tk.Label(
        content,
        text="Report an emergency situation by providing the information below.",
        font=("Arial", 10),
        bg="#F5F6FA",
        fg="#444444"
    )

    report_subtitle.pack(
        pady=(0, 15)
    )


    # =========================
    # FORM
    # =========================

    form_frame = tk.Frame(
        content,
        bg="white",
        bd=1,
        relief="solid"
    )

    form_frame.pack(
        padx=180,
        fill="x"
    )


    # =========================
    # NAME
    # =========================

    name_label = tk.Label(
        form_frame,
        text="Name",
        font=("Arial", 10, "bold"),
        bg="white",
        fg="#123B6D"
    )

    name_label.pack(
        anchor="w",
        padx=20,
        pady=(15, 3)
    )


    name_entry = tk.Entry(
        form_frame,
        font=("Arial", 10)
    )

    name_entry.pack(
        fill="x",
        padx=20
    )


    # =========================
    # CONTACT NUMBER
    # =========================

    contact_label = tk.Label(
        form_frame,
        text="Contact Number",
        font=("Arial", 10, "bold"),
        bg="white",
        fg="#123B6D"
    )

    contact_label.pack(
        anchor="w",
        padx=20,
        pady=(10, 3)
    )


    contact_entry = tk.Entry(
        form_frame,
        font=("Arial", 10)
    )

    contact_entry.pack(
        fill="x",
        padx=20
    )


    # =========================
    # LOCATION
    # =========================

    location_label = tk.Label(
        form_frame,
        text="Location",
        font=("Arial", 10, "bold"),
        bg="white",
        fg="#123B6D"
    )

    location_label.pack(
        anchor="w",
        padx=20,
        pady=(10, 3)
    )


    location_entry = tk.Entry(
        form_frame,
        font=("Arial", 10)
    )

    location_entry.pack(
        fill="x",
        padx=20
    )


    # =========================
    # EMERGENCY TYPE
    # =========================

    type_label = tk.Label(
        form_frame,
        text="Emergency Type",
        font=("Arial", 10, "bold"),
        bg="white",
        fg="#123B6D"
    )

    type_label.pack(
        anchor="w",
        padx=20,
        pady=(10, 3)
    )


    emergency_type = tk.StringVar()

    type_menu = tk.OptionMenu(
        form_frame,
        emergency_type,
        "Flood",
        "Earthquake",
        "Fire",
        "Tsunami",
        "Other"
    )

    type_menu.config(
        font=("Arial", 10),
        bg="white",
        width=20
    )

    type_menu.pack(
        anchor="w",
        padx=20
    )


    # =========================
    # DESCRIPTION
    # =========================

    description_label = tk.Label(
        form_frame,
        text="Description",
        font=("Arial", 10, "bold"),
        bg="white",
        fg="#123B6D"
    )

    description_label.pack(
        anchor="w",
        padx=20,
        pady=(10, 3)
    )


    description_entry = tk.Text(
        form_frame,
        font=("Arial", 10),
        height=4
    )

    description_entry.pack(
        fill="x",
        padx=20
    )


    # =========================
    # SUBMIT
    # =========================

    def submit_report():

        name = name_entry.get()
        contact = contact_entry.get()
        location = location_entry.get()
        emergency = emergency_type.get()
        description = description_entry.get(
            "1.0",
            "end-1c"
        )


        if (
            name == ""
            or contact == ""
            or location == ""
            or emergency == ""
            or description == ""
        ):

            messagebox.showwarning(
                "Incomplete Report",
                "Please complete all fields."
            )

            return


        messagebox.showinfo(
            "Emergency Report",
            "Emergency report submitted successfully."
        )


    submit_button = tk.Button(
        form_frame,
        text="Submit Report",
        font=("Arial", 10, "bold"),
        bg="#C62828",
        fg="white",
        activebackground="#C62828",
        activeforeground="white",
        relief="flat",
        cursor="hand2",
        command=submit_report
    )

    submit_button.pack(
        pady=15
    )


# =========================
# CLEAR CONTENT
# =========================

def clear_content():

    for widget in content.winfo_children():
        widget.destroy()


# =========================
# START
# =========================

show_emergency_report()

window.mainloop()

