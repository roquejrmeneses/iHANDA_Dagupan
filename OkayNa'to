                lambda i=index: self.delete_evacuation(i),
                bg=RED
            ).pack(side="left", padx=2)

    def add_evacuation(self):
        self.evacuation_form()

    def edit_evacuation(self, index):
        self.evacuation_form(
            index=index,
            data=EVACUATION_AREAS[index]
        )

    def evacuation_form(self, index=None, data=None):
        win = tk.Toplevel(self)
        win.title(
            "Edit Evacuation Area"
            if data else
            "Add Evacuation Area"
        )
        win.geometry("500x520")
        win.resizable(False, False)
        win.configure(bg=BACKGROUND)
        win.grab_set()

        card = tk.Frame(
            win,
            bg=WHITE,
            padx=25,
            pady=25
        )
        card.pack(
            fill="both",
            expand=True,
            padx=20,
            pady=20
        )

        tk.Label(
            card,
            text=(
                "Edit Evacuation Area"
                if data else
                "Add Evacuation Area"
            ),
            font=("Arial", 18, "bold"),
            bg=WHITE,
            fg=BLUE
        ).pack(anchor="w", pady=(0, 15))

        entries = {}

        fields = [
            ("Location Name", "name"),
            ("Barangay", "barangay"),
            ("Address / Landmark", "location"),
            ("Capacity", "capacity"),
            ("Notes", "notes")
        ]

        for label, key in fields:
            tk.Label(
                card,
                text=label,
                font=("Arial", 9, "bold"),
                bg=WHITE,
                fg=TEXT
            ).pack(anchor="w")

            entry = tk.Entry(
                card,
                font=("Arial", 10)
            )
            entry.pack(fill="x", pady=(3, 10))

            if data:
                entry.insert(0, data.get(key, ""))

            entries[key] = entry

        def save():
            values = {
                key: entries[key].get().strip()
                for _, key in fields
            }

            if not values["name"] or not values["barangay"]:
                messagebox.showwarning(
                    "Missing Information",
                    "Location Name and Barangay are required.",
                    parent=win
                )
                return

            if index is None:
                EVACUATION_AREAS.append(values)
            else:
                EVACUATION_AREAS[index] = values

            win.destroy()
            self.build()

            evacuation_page = self.controller.frames[
                "EvacuationScreen"
            ]
            evacuation_page.refresh()

        make_button(
            card,
            "SAVE",
            save,
            bg=RED
        ).pack(anchor="e", pady=(5, 0))

    def delete_evacuation(self, index):
        answer = messagebox.askyesno(
            "Delete Evacuation Area",
            "Are you sure you want to delete this evacuation area?"
        )

        if answer:
            del EVACUATION_AREAS[index]
            self.build()

            evacuation_page = self.controller.frames[
                "EvacuationScreen"
            ]
            evacuation_page.refresh()

    def logout(self):
        self.controller.admin_logged_in = False
        self.controller.show_frame("HomeScreen")


