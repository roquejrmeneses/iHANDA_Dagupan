# =========================================================
# DISASTER RECOGNITION
# =========================================================

class DisasterScreen(ScrollPage):

    def __init__(self, parent, controller):
        super().__init__(parent, bg=BACKGROUND)

        create_navigation(self, controller, "DisasterScreen")
        self.setup_scroll()

        tk.Label(
            self.content,
            text="Disaster Recognition",
            font=("Arial", 25, "bold"),
            bg=BACKGROUND,
            fg=BLUE
        ).pack(anchor="w")

        tk.Label(
            self.content,
            text="Click a disaster to show or hide its information.",
            font=("Arial", 11),
            bg=BACKGROUND,
            fg=GRAY
        ).pack(anchor="w", pady=(4, 18))

        self.cards = {}

        for name in DISASTERS:
            self.create_disaster_card(name)

        create_footer(self)

    def create_disaster_card(self, name):
        outer = tk.Frame(
            self.content,
            bg=WHITE,
            highlightbackground=BORDER,
            highlightthickness=1
        )
        outer.pack(fill="x", pady=5)

        button = tk.Button(
            outer,
            text="  " + name,
            anchor="w",
            font=("Arial", 12, "bold"),
            bg=WHITE,
            fg=BLUE,
            activebackground=LIGHT_BLUE,
            activeforeground=BLUE,
            relief="flat",
            bd=0,
            padx=12,
            pady=13,
            command=lambda n=name: self.toggle_disaster(n)
        )
        button.pack(fill="x")

        info = tk.Frame(
            outer,
            bg=WHITE,
            padx=22,
            pady=15
        )

        self.cards[name] = {
            "info": info,
            "button": button,
            "open": False
        }

    def toggle_disaster(self, name):
        data = DISASTERS[name]
        card = self.cards[name]

        if card["open"]:
            card["info"].pack_forget()
            card["open"] = False
            card["button"].config(text="  " + name)
            return

        clear_frame(card["info"])

        tk.Label(
            card["info"],
            text=data["description"],
            font=("Arial", 10),
            bg=WHITE,
            fg=TEXT,
            justify="left",
            wraplength=850
        ).pack(anchor="w", pady=(0, 10))

        for title, key in [
            ("BEFORE", "before"),
            ("DURING", "during"),
            ("AFTER", "after")
        ]:
            tk.Label(
                card["info"],
                text=title,
                font=("Arial", 12, "bold"),
                bg=WHITE,
                fg=RED
            ).pack(anchor="w", pady=(8, 4))

            for item in data[key]:
                tk.Label(
                    card["info"],
                    text="• " + item,
                    font=("Arial", 10),
                    bg=WHITE,
                    fg=TEXT,
                    justify="left",
                    wraplength=850
                ).pack(anchor="w", pady=2)

        tk.Label(
            card["info"],
            text="Source: " + data["source"],
            font=("Arial", 9, "italic"),
            bg=WHITE,
            fg=GRAY
        ).pack(anchor="w", pady=(12, 0))

        card["info"].pack(fill="x")
        card["open"] = True
        card["button"].config(text="  ▲ " + name)


