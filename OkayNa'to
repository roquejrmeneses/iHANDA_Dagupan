        photo_row.pack(fill="x", pady=(4, 15))

        make_button(
            photo_row,
            "IMPORT PHOTO",
            self.import_photo,
            bg=RED
        ).pack(side="left")

        self.photo_label = tk.Label(
            photo_row,
            text="No photo selected",
            font=("Arial", 9),
            bg=WHITE,
            fg=GRAY
        )
        self.photo_label.pack(side="left", padx=12)

        make_button(
            form,
            "SUBMIT EMERGENCY REPORT",
            self.submit_report,
            bg=RED
        ).pack(anchor="e")

        create_footer(self)

    def field(self, parent, label):
        tk.Label(
            parent,
            text=label,
            font=("Arial", 10, "bold"),
            bg=WHITE,
            fg=TEXT
        ).pack(anchor="w")

        entry = tk.Entry(
            parent,
            font=("Arial", 10)
        )
        entry.pack(fill="x", pady=(4, 13))

        return entry

    def filter_barangays(self, event=None):
        text = self.barangay.get().lower().strip()

        if not text or text == "select or type barangay...":
            values = BARANGAYS
        else:
            values = [
                x for x in BARANGAYS
                if text in x.lower()
            ]

        self.barangay["values"] = values

    def import_photo(self):
        path = filedialog.askopenfilename(
            title="Select Emergency Photo",
            filetypes=[
                ("Image Files", "*.jpg *.jpeg *.png *.gif"),
                ("All Files", "*.*")
            ]
        )

        if path:
            self.photo_path = path
            self.photo_label.config(
                text=os.path.basename(path),
                fg=TEXT
            )

    def submit_report(self):
        name = self.name.get().strip()
        contact = self.contact.get().strip()
        barangay = self.barangay.get().strip()
        location = self.location.get().strip()
        emergency = self.emergency.get()
        description = self.description.get("1.0", "end").strip()

        if not name:
            messagebox.showwarning("Missing Information", "Please enter your name.")
            return

        if not name.replace(" ", "").isalpha():
            messagebox.showwarning(
                "Invalid Name",
                "Name should contain letters and spaces only."
            )
            return

        if not contact:
            messagebox.showwarning(
                "Missing Information",
                "Please enter your contact number."
            )
            return

        if not contact.isdigit():
            messagebox.showwarning(
                "Invalid Contact",
                "Contact number should contain numbers only."
            )
            return

        if (
            not barangay or
            barangay.lower() == "select or type barangay..."
        ):
            messagebox.showwarning(
                "Missing Information",
                "Please select or enter your Barangay / Area."
            )
            return

        if not location:
            messagebox.showwarning(
                "Missing Information",
                "Please enter the exact location or landmark."
            )
            return

        if emergency == "Select Emergency Type":
            messagebox.showwarning(
                "Missing Information",
                "Please select an emergency type."
            )
            return

        if not description:
            messagebox.showwarning(
                "Missing Information",
                "Please enter a description."
            )
            return

        report = {
            "name": name,
            "contact": contact,
            "barangay": barangay,
            "location": location,
            "emergency": emergency,
            "description": description,
            "photo": self.photo_path,
            "date_time": datetime.now().strftime(
                "%B %d, %Y | %I:%M %p"
            )
        }

        EMERGENCY_REPORTS.append(report)

        messagebox.showinfo(
            "Report Submitted",
            "Your emergency report has been submitted successfully."
        )

        self.clear_form()

    def clear_form(self):
        self.name.delete(0, "end")
        self.contact.delete(0, "end")
        self.barangay.set("Select or type barangay...")
        self.location.delete(0, "end")
        self.emergency.set("Select Emergency Type")
        self.description.delete("1.0", "end")

        self.photo_path = ""
        self.photo_label.config(
            text="No photo selected",
            fg=GRAY
        )


