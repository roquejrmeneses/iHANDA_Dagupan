    def build_header(self, main):
        head = tk.Frame(
            main, bg=WHITE, highlightbackground=BORDER, highlightthickness=1
        )
        head.pack(fill="x")

        self.header_title = tk.Label(
            head, text="", font=("Arial", 18, "bold"), bg=WHITE, fg=BLUE
