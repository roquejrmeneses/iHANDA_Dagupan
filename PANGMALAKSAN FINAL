                wrap_to_width(label, 500)

        tk.Label(
            card["info"],
            text="Source: " + data["source"],
            font=("Arial", 10, "italic"),
            bg=WHITE,
            fg=GRAY
        ).pack(anchor="w", pady=(10, 0))

