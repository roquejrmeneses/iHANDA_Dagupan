        self.username.pack(fill="x", pady=(4, 12), ipady=3)

        tk.Label(
            card,
            text="Password",
            font=("Arial", 10, "bold"),
            bg=WHITE,
            fg=TEXT
        ).pack(anchor="w")

        self.password = tk.Entry(
            card,
            font=("Arial", 10),
            show="•"
        )
        self.password.pack(fill="x", pady=(4, 18), ipady=3)

        # Pressing Enter also logs in
        self.username.bind("<Return>", lambda e: self.login())
        self.password.bind("<Return>", lambda e: self.login())

        make_button(
            card,
            "LOGIN",
            self.login,
            bg=RED
        ).pack(fill="x")

        tk.Button(
            card,
            text="Back to Home",
            command=lambda: controller.show_frame("HomeScreen"),
            font=("Arial", 9),
            bg=WHITE,
            fg=BLUE,
            relief="flat",
            cursor="hand2"
        ).pack(pady=(12, 0))

    def login(self):
        if (
            self.username.get() == ADMIN_USERNAME and
            self.password.get() == ADMIN_PASSWORD
        ):
            self.controller.admin_logged_in = True

            self.username.delete(0, "end")
            self.password.delete(0, "end")

            self.controller.show_frame("AdminScreen")

        else:
            self.password.delete(0, "end")
            messagebox.showerror(
                "Access Denied",
                "Incorrect username or password."
            )


