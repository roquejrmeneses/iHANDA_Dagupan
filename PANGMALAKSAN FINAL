        style.configure("Treeview.Heading", font=("Arial", 10, "bold"))

        self.current_frame = None
        self.admin_logged_in = False

        self.frames = {}

        container = tk.Frame(self, bg=BACKGROUND)
        container.pack(fill="both", expand=True)

        container.grid_rowconfigure(0, weight=1)
        container.grid_columnconfigure(0, weight=1)

        self.container = container

        pages = (
            HomeScreen,
            DisasterScreen,
            ReadyKitScreen,
            HotlinesScreen,
            FirstAidScreen,
            EvacuationScreen,
            EmergencyReportScreen,
            AdminLoginScreen,
            AdminScreen
        )

        for Page in pages:
            frame = Page(container, self)
            self.frames[Page.__name__] = frame
            frame.grid(row=0, column=0, sticky="nsew")

        self.bind_all("<MouseWheel>", self.global_scroll)

        self.show_frame("HomeScreen")

    # The admin session lives in ADMIN_SESSION so that protected
    # functions can check it without needing a reference to the app.
    @property
    def admin_logged_in(self):
        return ADMIN_SESSION["active"]

    @admin_logged_in.setter
    def admin_logged_in(self, value):
        ADMIN_SESSION["active"] = bool(value)

    def show_frame(self, page_name):
        # Admin pages are protected: no session -> login screen.
        if page_name == "AdminScreen" and not self.admin_logged_in:
            page_name = "AdminLoginScreen"

        frame = self.frames[page_name]
        self.current_frame = frame
        frame.tkraise()

        if hasattr(frame, "reset_scroll"):
            frame.reset_scroll()

        if page_name in ("AdminScreen", "EvacuationScreen"):
            frame.refresh()

    def global_scroll(self, event):
        # Ignore scrolling inside pop-up windows / dropdown lists
        try:
            if event.widget.winfo_toplevel() is not self:
                return
        except Exception:
            pass

        if self.current_frame and hasattr(
            self.current_frame, "mouse_scroll"
        ):
            self.current_frame.mouse_scroll(event)


