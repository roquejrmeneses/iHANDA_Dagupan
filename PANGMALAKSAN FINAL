EMERGENCY_REPORTS = []


# =========================================================
# REPORT SERVICE LAYER
# All report creation / updates go through these functions so
# every screen sees the same, consistent data. Each function
# finds the report by its unique report_id, so an action can
# never change a different report by accident.
# =========================================================

def now_text():
    return datetime.now().strftime("%B %d, %Y | %I:%M %p")


def require_admin():
    """Raised for any protected action when no admin is logged in."""
    if not ADMIN_SESSION["active"]:
        raise PermissionError("Administrator login required.")


def new_report_id():
    stamp = datetime.now().strftime("%Y%m%d")
    existing = {r["report_id"] for r in EMERGENCY_REPORTS}
    number = len(EMERGENCY_REPORTS) + 1

    while f"IH-{stamp}-{number:04d}" in existing:
        number += 1

    return f"IH-{stamp}-{number:04d}"


def add_history(report, text):
    stamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    report["history"].append(f"[{stamp}] {text}")


def find_report(report_id):
    for report in EMERGENCY_REPORTS:
        if report["report_id"] == report_id:
            return report
    return None


def find_duplicate(data):
    """Return an unresolved report with identical content, if any."""
    keys = ("name", "contact", "barangay", "location",
            "emergency", "description")

    for report in EMERGENCY_REPORTS:
        if report["status"] == "Resolved":
            continue
        if all(
            str(report[k]).lower() == str(data[k]).lower() for k in keys
        ):
            return report
    return None


def create_report(data):
    """Save a new report (public action - no admin login needed)."""
    report = {
        "report_id": new_report_id(),
        "name": data["name"],
        "contact": data["contact"],
        "barangay": data["barangay"],
        "location": data["location"],
        "emergency": data["emergency"],
        "description": data["description"],
        "photo": data["photo"],
        "date_time": now_text(),
        "submitted_iso": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "status": "Pending",
        "assigned_organization": UNASSIGNED,
        "response_notes": "",
        "completed_at": "",
        "sent_to_officials": "",
        "sent_to_officials_at": "",
        "history": []
    }
    add_history(report, "Report created. " + DELIVERY_NOTE + ".")
    EMERGENCY_REPORTS.append(report)
    return report


def update_report(report_id, status, organization, notes):
    """Update status / organization / notes. Returns (ok, message)."""
    require_admin()

    report = find_report(report_id)
    notes = notes.strip() if notes else ""

    if report is None:
        return False, "Report not found."

    if status not in REPORT_STATUSES:
        return False, "Please select a valid status."

    if organization not in RESPONSE_ORGANIZATIONS:
        return False, "Please select a valid organization."

    if status in ("In Progress", "Resolved") and organization == UNASSIGNED:
        return False, (
            "Please assign an organization before setting the status to "
            f"'{status}'."
        )

    if len(notes) > 1000:
        return False, "Response notes must be 1000 characters or fewer."

    old_status = report["status"]
    changed = False
    message = "Report updated successfully."

    if status != old_status:
        add_history(report, f"Status changed: {old_status} -> {status}")
        report["status"] = status
        changed = True

        if status == "Resolved":
            report["completed_at"] = now_text()
            add_history(
                report, "Response completed. Moved to Response Archive."
            )
            message = (
                "Report marked as Resolved and moved to the Response Archive."
            )
        elif old_status == "Resolved":
            add_history(
                report,
                "Report reopened (previously completed on "
                f"{report['completed_at'] or 'unknown date'})."
            )
            report["completed_at"] = ""
            message = "Report reopened and returned to Active Reports."

    if organization != report["assigned_organization"]:
        add_history(
            report,
            "Assigned organization: "
            f"{report['assigned_organization']} -> {organization}"
        )
        report["assigned_organization"] = organization
        changed = True

    if notes != report["response_notes"]:
        report["response_notes"] = notes
        add_history(
            report,
            "Response notes updated: "
            + (" ".join(notes.split())[:120] if notes else "(cleared)")
        )
        changed = True

    if not changed:
        return True, "No changes to save."

    return True, message


def reopen_report(report_id):
    """Move an archived report back to Active Reports. Returns (ok, message)."""
    require_admin()

    report = find_report(report_id)

    if report is None:
        return False, "Report not found."

    if report["status"] != "Resolved":
        return False, "Only archived (Resolved) reports can be reopened."

    add_history(
        report,
        "Report reopened (previously completed on "
        f"{report['completed_at'] or 'unknown date'}). Status: In Progress"
    )
    report["status"] = "In Progress"
    report["completed_at"] = ""

    return True, "Report reopened and returned to Active Reports."


def dispatch_report(report_id, recipients):
    """SIMULATED dispatch. Nobody is contacted. Returns (ok, message)."""
    require_admin()

    report = find_report(report_id)

    if report is None:
        return False, "Report not found."

    if report["status"] == "Resolved":
        return False, "Archived reports cannot be dispatched. Reopen it first."

    if report["sent_to_officials"]:
        return False, "This report was already marked as sent in the simulation."

    recipients = [r for r in recipients if r in DISPATCH_RECIPIENTS]

    if not recipients:
        return False, "Select at least one official or agency first."

    text = ", ".join(recipients)
    report["sent_to_officials"] = text
    report["sent_to_officials_at"] = now_text()
    add_history(report, f"SIMULATED response dispatch to {text}")

    return True, text


def filter_reports(mode, text="", rtype="", status="", org="", date=""):
    """mode: 'active', 'archive' or 'all'. Newest first."""
    text = text.lower().strip()
    result = []

    for r in EMERGENCY_REPORTS:
        resolved = r["status"] == "Resolved"

        if mode == "active" and resolved:
            continue
        if mode == "archive" and not resolved:
            continue
        if rtype and r["emergency"] != rtype:
            continue
        if status and r["status"] != status:
            continue
        if org and r["assigned_organization"] != org:
            continue
        if date and not r["submitted_iso"].startswith(date):
            continue
        if text:
            haystack = " ".join(
                str(r[k]) for k in (
                    "report_id", "name", "barangay", "location",
                    "emergency", "description", "response_notes",
                    "assigned_organization"
                )
            ).lower()
            if text not in haystack:
                continue

        result.append(r)

    result.sort(
        key=lambda r: (r["submitted_iso"], r["report_id"]), reverse=True
    )
    return result


def org_contact(org):
    """Contact number from the existing HOTLINES list only (never invented)."""
    if org == UNASSIGNED:
        return "-"

    name = ORG_HOTLINE_NAME.get(org)

    for hotline_name, number in HOTLINES:
        if hotline_name == name:
            return number

    return "No contact listed"


