import tkinter as tk
from tkinter import ttk, messagebox
from datetime import datetime


# =========================
# QUEUE DATA
# =========================

registrar_queue = []
finance_queue = []

registrar_number = 0
finance_number = 0

current_registrar = None
current_finance = None


# =========================
# MAIN WINDOW
# =========================

root = tk.Tk()
root.title("QueueEase - PHINMA University of Pangasinan")
root.geometry("950x650")
root.resizable(False, False)


# =========================
# FUNCTIONS
# =========================

def update_display():
    """Update the queue display."""

    if current_registrar:
        registrar_now_label.config(
            text=f"R-{current_registrar:03d}"
        )
    else:
        registrar_now_label.config(
            text="---"
        )

    if current_finance:
        finance_now_label.config(
            text=f"F-{current_finance:03d}"
        )
    else:
        finance_now_label.config(
            text="---"
        )

    update_waiting_list()


def get_queue():
    """Generate a queue number for the student."""

    global registrar_number
    global finance_number

    name = name_entry.get().strip()
    office = office_combo.get()
    service = service_combo.get()

    if not name:
        messagebox.showwarning(
            "Missing Information",
            "Please enter your name."
        )
        return

    if not office or not service:
        messagebox.showwarning(
            "Missing Information",
            "Please select an office and service."
        )
        return

    if office == "Registrar":

        registrar_number += 1
        number = registrar_number

        registrar_queue.append({
            "number": number,
            "name": name,
            "service": service,
            "status": "Waiting"
        })

        queue_number = f"R-{number:03d}"

    else:

        finance_number += 1
        number = finance_number

        finance_queue.append({
            "number": number,
            "name": name,
            "service": service,
            "status": "Waiting"
        })

        queue_number = f"F-{number:03d}"

    messagebox.showinfo(
        "Queue Number",
        f"Your queue number is:\n\n"
        f"{queue_number}\n\n"
        f"Office: {office}\n"
        f"Service: {service}\n\n"
        f"Please monitor the queue."
    )

    name_entry.delete(0, tk.END)

    update_display()


def call_next():
    """Call the next waiting student."""

    global current_registrar
    global current_finance

    office = staff_office_combo.get()

    if office == "Registrar":

        if not registrar_queue:
            messagebox.showinfo(
                "Queue",
                "There are no students waiting in Registrar."
            )
            return

        # Find first waiting student
        for student in registrar_queue:

            if student["status"] == "Waiting":

                student["status"] = "Now Serving"
                current_registrar = student["number"]

                messagebox.showinfo(
                    "Now Serving",
                    f"Now serving:\n\n"
                    f"R-{student['number']:03d}\n"
                    f"{student['name']}"
                )

                update_display()
                return

        messagebox.showinfo(
            "Queue",
            "No waiting students in Registrar."
        )

    else:

        if not finance_queue:
            messagebox.showinfo(
                "Queue",
                "There are no students waiting in Finance."
            )
            return

        for student in finance_queue:

            if student["status"] == "Waiting":

                student["status"] = "Now Serving"
                current_finance = student["number"]

                messagebox.showinfo(
                    "Now Serving",
                    f"Now serving:\n\n"
                    f"F-{student['number']:03d}\n"
                    f"{student['name']}"
                )

                update_display()
                return

        messagebox.showinfo(
            "Queue",
            "No waiting students in Finance."
        )


def complete_transaction():
    """Mark current transaction as completed."""

    global current_registrar
    global current_finance

    office = staff_office_combo.get()

    if office == "Registrar":

        if current_registrar is None:
            messagebox.showwarning(
                "No Transaction",
                "There is no current Registrar transaction."
            )
            return

        for student in registrar_queue:

            if student["number"] == current_registrar:
                student["status"] = "Completed"
                break

        current_registrar = None

    else:

        if current_finance is None:
            messagebox.showwarning(
                "No Transaction",
                "There is no current Finance transaction."
            )
            return

        for student in finance_queue:

            if student["number"] == current_finance:
                student["status"] = "Completed"
                break

        current_finance = None

    update_display()


def update_waiting_list():
    """Update the waiting list."""

    for item in waiting_table.get_children():
        waiting_table.delete(item)

    for student in registrar_queue:

        waiting_table.insert(
            "",
            tk.END,
            values=(
                f"R-{student['number']:03d}",
                student["name"],
                "Registrar",
                student["service"],
                student["status"]
            )
        )

    for student in finance_queue:

        waiting_table.insert(
            "",
            tk.END,
            values=(
                f"F-{student['number']:03d}",
                student["name"],
                "Finance",
                student["service"],
                student["status"]
            )
        )


def post_announcement():
    """Post a general announcement."""

    announcement = announcement_entry.get().strip()

    if not announcement:
        messagebox.showwarning(
            "Announcement",
            "Please enter an announcement."
        )
        return

    announcement_label.config(
        text=f"📢 {announcement}"
    )

    announcement_entry.delete(0, tk.END)


def update_services(event=None):
    """Change services depending on selected office."""

    office = office_combo.get()

    if office == "Registrar":

        service_combo["values"] = [
            "Request Documents",
            "Enrollment Concern",
            "Student Records",
            "Other Concern"
        ]

    elif office == "Finance":

        service_combo["values"] = [
            "Payment",
            "Billing Concern",
            "Assessment Concern",
            "Other Concern"
        ]

    service_combo.set("")


